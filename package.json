{
  "name": "modumunje-public-ui-extract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:export": "node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit",
